# Configuracoes do Servidor Multiplayer CTR Turbocharged

# Porta HTTP da API de Lobby (Criacao de salas, listagem, busca por codigo)
HTTP_PORT=8080

# Porta UDP interna do Relay de Gameplay
UDP_PORT=31850

# Endereco e Porta Publica (usado caso esteja usando tunel Playit.gg ou ngrok)
PUBLIC_HOST=127.0.0.1
PUBLIC_UDP_PORT=31850

# Tempo limite de inatividade (ms) para expirar jogadores sem heartbeat (padrao: 12000 = 12s)
HEARTBEAT_TIMEOUT_MS=12000
